NEXT_PUBLIC_SITE_URL=http://localhost:3000
SOFLOTT_API_BASE_URL=http://localhost:5235

# --- Public website (all optional; placeholders are used when unset) -------
# Contact
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=info@soflott.de
# Division inboxes: courier -> dispatch, IT/software -> digital
NEXT_PUBLIC_EXPRESS_EMAIL=dispatch@soflott.de
NEXT_PUBLIC_DIGITAL_EMAIL=digital@soflott.de
# Express service area named in metadata / structured data
NEXT_PUBLIC_SERVICE_AREA=
# Imprint (Impressum) - from the commercial register entry
NEXT_PUBLIC_LEGAL_MANAGING_DIRECTORS=
NEXT_PUBLIC_LEGAL_REGISTER_COURT=
NEXT_PUBLIC_LEGAL_REGISTER_NUMBER=
NEXT_PUBLIC_LEGAL_VAT_ID=
# Set to true once imprint and privacy policy are legally reviewed
NEXT_PUBLIC_LEGAL_REVIEWED=false
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_COUNTRY=DE

# --- Cookie consent and privacy ---------------------------------------------
# Optional tracking is OFF unless the matching ID is set, and it only ever
# loads after the visitor consents (Google Consent Mode v2 starts "denied").
# Analytics category
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Marketing category
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Send each consent decision to the API as evidence (POST /api/privacy/consent).
# Set to false to switch it off.
NEXT_PUBLIC_CONSENT_EVIDENCE=true
